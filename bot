#!/usr/bin/env bash
set -euo pipefail
SERVICE=darvas-bot
case "${1:-help}" in
 status) systemctl status "$SERVICE" --no-pager ;;
 health) systemctl is-active "$SERVICE" && echo "service: healthy" ;;
 logs) journalctl -u "$SERVICE" -n "${2:-100}" --no-pager ;;
 follow) journalctl -u "$SERVICE" -f ;;
 restart) sudo systemctl restart "$SERVICE" ;;
 test) source venv/bin/activate; python -m compileall -q .; pytest -q ;;
 capture) echo "Capture helper will be finalized after WebSocket auth/schema are confirmed."; echo "Do not enable LIVE_TRADING for capture." ;;
 version) git rev-parse --short HEAD ;;
 update)
   test -z "$(git status --porcelain)" || { echo "Refusing update: local changes exist"; exit 1; }
   OLD="$(git rev-parse HEAD)"; git pull --ff-only; source venv/bin/activate; pip install -r requirements.txt
   if python -m compileall -q . && pytest -q; then sudo systemctl restart "$SERVICE"; systemctl is-active "$SERVICE"; else echo "Validation failed; rolling back to $OLD"; git reset --hard "$OLD"; sudo systemctl restart "$SERVICE"; exit 1; fi ;;
 *) echo "Usage: ./bot {status|health|logs [N]|follow|restart|test|capture|version|update}" ;;
esac
